#
# Python Model (16 Pins available)
#


class Controller:
    def __init__(self):
        """Setup input/outputs"""

        self.ripple = 1e-3  # 1mA ripple current / hysteresis
        self.i_ist = 1  # 1A output current

        self.VDD = Input(0)  # 3.3 volt
        self.VSS = Input(8)

        self.en_1 = ResistorOutput(15, 10, self.VDD, self.VSS)
        self.en_2 = ResistorOutput(12, 10.0, self.VDD, self.VSS)

        self.i_out = Input(4)

        self.en_1.set_state(0)

        add_breakpoint(10e-9)

    def update(self, time):

        # Update each time point
        if self.i_out.get_v() > self.ripple + self.i_ist:
            self.en_1.set_state(0)
            # add_breakpoint(time + 10e-9)
        elif self.i_out.get_v() < -self.ripple + self.i_ist:
            self.en_1.set_state(1)
            # add_breakpoint(time + 10e-9)
