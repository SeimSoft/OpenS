* Main Circuit

.preprocess addresistors nodcpath 1G
.model CONTROLLER_HERIC npy MODULE=controller CLASS=Controller PYTHONPATH=/Users/rennekef/Documents/SchematicEntry/backup/tests/grid-tie/grid-tie-lib/heric_inverter
