R1_ser int_1 N_3 0.01
N1 VDD_3V3 N_6 N_7 N_8 I_MEAS N_9 N_10 N_11 VSS N_12 N_13 N_14 VS2 N_15 N_16 VS1 CONTROLLER_HERIC
R1 I_MEAS VSS 100
R2 VIN_350VDC N_1 0.01
LP1 N_4 N_2 1u
LS1 I_MEAS VSS 20m
K1 LP1 LS1 0.99
V1 N_3 N_4 dc 0 ac 0
