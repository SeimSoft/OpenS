.model BOOT_DIODE D (IS=1e-14 N=1 RS=0.1 CJO=1p M=0.5 TT=1n)
.model POWER_MOS NMOS (LEVEL=1 VTO=2.5 KP=0.5 LAMBDA=0.02 CGSO=100p CGDO=10p CBD=50p)
